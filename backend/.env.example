PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
DELIVERY_CHARGE=0

# --- YOUPI PG ONLINE PAYMENT (self-hosted UPI gateway) ---
# Base URL of YOUR YouPI PG payment API (no trailing slash), e.g. https://pay.yourdomain.com
YOUPI_BASE_URL=
# Optional merchant public id from the YouPI admin panel:
YOUPI_MERCHANT_ID=
# Webhook signing secret - MUST match the secret configured on your YouPI PG server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
YOUPI_WEBHOOK_SECRET=
# In the YouPI admin panel set the merchant webhook URL to:
#   https://<your-backend-domain>/api/payments/youpi/webhook

# --- MANUAL UPI (free, no payment gateway) ---
# UPI ID (VPA) customers pay at checkout via QR / UPI app. Defaults to the shop UPI ID below.
MANUAL_UPI_VPA=nagaraj1212005@oksbi
# Name shown in the customer's UPI app:
MANUAL_UPI_PAYEE_NAME=MJ Foods
